<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>normal_nokey</AssemblyName>
    <PublishedExecutableName>normal-nokey</PublishedExecutableName>
    <RootNamespace>WindowsClient</RootNamespace>
    <AssemblyTitle>Windows client</AssemblyTitle>
    <Product>Windows client</Product>
    <Description>Windows client</Description>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <CodePage>65001</CodePage>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\question_bank.bin" />
  </ItemGroup>
  <Target Name="RenamePublishedExecutable" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(PublishDir)$(PublishedExecutableName).exe"
          Condition="Exists('$(PublishDir)$(AssemblyName).exe') And '$(AssemblyName)' != '$(PublishedExecutableName)'" />
  </Target>
</Project>
