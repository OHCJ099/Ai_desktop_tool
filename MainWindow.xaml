<Window x:Class="WindowsClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows client"
        Height="42"
        Width="172"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseDown="Window_MouseDown"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">
    <Grid>
        <!-- 极简正常态：输入框 + 小数点 + 透明点击区。 -->
        <Grid Name="MainContentGrid" Opacity="0" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="MainToolbar" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Name="QueryTextBox"
                         Width="118"
                         Height="22"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="Black"
                         CaretBrush="Black"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"
                         KeyDown="QueryTextBox_KeyDown"/>

                <TextBlock Name="DotButton" Text="." FontSize="16" FontWeight="Bold" Foreground="Black" Cursor="Hand" Width="16" TextAlignment="Center"
                           MouseDown="DotButton_MouseDown" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"/>

                <Border Name="TransparentButton" Width="24" Height="22" Margin="6,0,0,0" Background="#01000000" Cursor="Hand"
                        MouseDown="TransparentButton_MouseDown"/>
            </StackPanel>

            <!-- Settings: API credentials and independent opacity controls. -->
            <Grid x:Name="SettingsScrollViewer" Grid.Row="0" Grid.RowSpan="2" Margin="0" Background="Transparent" Visibility="Collapsed"
                  MouseDown="SettingsSurface_MouseDown">
                <StackPanel Orientation="Vertical" Margin="8">
                    <TextBox Name="SettingsApiUrl" Height="23" Margin="0,2,0,5" Background="Transparent" BorderThickness="0" Foreground="#80000000" TextChanged="SettingsTextChanged"/>
                    <TextBox Name="SettingsApiKey" Height="23" Margin="0,2,0,5" Background="Transparent" BorderThickness="0" Foreground="#80000000" TextChanged="SettingsTextChanged"/>
                    <TextBox Name="SettingsModelName" Height="23" Margin="0,2,0,5" Background="Transparent" BorderThickness="0" Foreground="#80000000" TextChanged="SettingsTextChanged"/>
                    <Slider Name="InputOpacitySlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1"
                            ValueChanged="OpacitySlider_ValueChanged" PreviewMouseLeftButtonUp="OpacitySlider_PreviewMouseLeftButtonUp"/>
                    <Slider Name="DotOpacitySlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1"
                            ValueChanged="OpacitySlider_ValueChanged" PreviewMouseLeftButtonUp="OpacitySlider_PreviewMouseLeftButtonUp"/>
                    <Button Content="&#x4FDD;&#x5B58;" Height="25" Margin="0,5,0,0" Foreground="#80000000"
                            Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Cursor="Hand" Click="SettingsSave_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 兼容旧逻辑的隐藏控件：不参与极简可视 UI。 -->
        <Grid x:Name="HiddenCompatControls" Visibility="Collapsed">
            <TextBlock Name="SendButton" Text="S"/>
            <TextBlock Name="LocalSearchButton" Text="s"/>
            <TextBlock Name="CefCaptureButton" Text="C"/>
            <TextBlock Name="AutoToggleButton" Text="K"/>
            <TextBlock Name="SettingsButton" Text="."/>
            <TextBlock Name="ExitButton" Text="x"/>
            <ScrollViewer x:Name="OutputScrollViewer"><TextBox Name="OutputTextBox" Text=""/></ScrollViewer>
        </Grid>
    </Grid>
</Window>
