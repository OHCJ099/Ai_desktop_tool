<Window x:Class="WindowsClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows client"
        Height="78"
        Width="172"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseDown="Window_MouseDown"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">
    <Grid>
        <!-- 极简正常态：输入框 + 小数点 + 透明点击区。 -->
        <Grid Name="MainContentGrid" Opacity="0" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="MainToolbar" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Name="QueryTextBox"
                         Width="96"
                         Height="22"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="Black"
                         CaretBrush="Black"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="0,0,4,0"
                         KeyDown="QueryTextBox_KeyDown"/>

                <TextBlock Name="DotButton" Text="S" FontSize="14" FontWeight="Bold" Foreground="Black" Cursor="Hand" Width="15" TextAlignment="Center"
                           MouseDown="SendButton_MouseDown" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"/>

                <TextBlock Name="LocalSearchButton" Text="D" FontSize="14" Foreground="Black" Cursor="Hand" Width="15" TextAlignment="Center"
                           MouseDown="LocalSearchButton_MouseDown" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"/>
                <TextBlock Name="SettingsButton" Text="Z" FontSize="14" Foreground="Black" Cursor="Hand" Width="15" TextAlignment="Center"
                           MouseDown="SettingsButton_MouseDown" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"/>
                <TextBlock Name="ExitButton" Text="X" FontSize="14" Foreground="Black" Cursor="Hand" Width="15" TextAlignment="Center"
                           MouseDown="ExitButton_MouseDown" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"/>
            </StackPanel>

            <ScrollViewer x:Name="OutputScrollViewer" Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                <TextBox Name="OutputTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         BorderThickness="0" Background="Transparent" Foreground="Black" FontSize="14"/>
            </ScrollViewer>

            <!-- Settings: API credentials and independent opacity controls. -->
            <Grid x:Name="SettingsScrollViewer" Grid.Row="0" Grid.RowSpan="2" Margin="0" Background="#EFFFFFFF" Visibility="Collapsed"
                  MouseDown="SettingsSurface_MouseDown">
                <StackPanel Orientation="Vertical" Margin="8">
                    <TextBlock Text="API URL" FontSize="11" Foreground="Black"/>
                    <TextBox Name="SettingsApiUrl" Height="23" Margin="0,2,0,5" TextChanged="SettingsTextChanged"/>
                    <TextBlock Text="API Key" FontSize="11" Foreground="Black"/>
                    <PasswordBox Name="SettingsApiKey" Height="23" Margin="0,2,0,5" PasswordChanged="SettingsPasswordChanged"/>
                    <TextBlock Text="Model" FontSize="11" Foreground="Black"/>
                    <TextBox Name="SettingsModelName" Height="23" Margin="0,2,0,5" TextChanged="SettingsTextChanged"/>
                    <TextBlock Text="&#x8F93;&#x5165;&#x6846;&#x5B57;&#x4F53;&#x900F;&#x660E;&#x5EA6;" FontSize="11" Foreground="Black"/>
                    <Slider Name="InputOpacitySlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1"
                            ValueChanged="OpacitySlider_ValueChanged" PreviewMouseLeftButtonUp="OpacitySlider_PreviewMouseLeftButtonUp"/>
                    <TextBlock Text="按钮透明度" FontSize="11" Foreground="Black"/>
                    <Slider Name="DotOpacitySlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1"
                            ValueChanged="OpacitySlider_ValueChanged" PreviewMouseLeftButtonUp="OpacitySlider_PreviewMouseLeftButtonUp"/>
                    <Button Content="&#x4FDD;&#x5B58;" Height="25" Margin="0,5,0,0" Click="SettingsSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 兼容旧逻辑的隐藏控件：不参与极简可视 UI。 -->
        <Grid x:Name="HiddenCompatControls" Visibility="Collapsed">
            <TextBlock Name="SendButton" Text="S"/>
            <TextBlock Name="CefCaptureButton" Text="C"/>
            <TextBlock Name="AutoToggleButton" Text="K"/>
        </Grid>
    </Grid>
</Window>
