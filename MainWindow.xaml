<Window x:Class="WindowsClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows client"
        Height="42"
        Width="172"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseDown="Window_MouseDown"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">
    <Grid>
        <!-- 极简正常态：输入框 + 小数点 + 透明点击区。 -->
        <Grid Name="MainContentGrid" Opacity="0" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="MainToolbar" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Name="QueryTextBox"
                         Width="118"
                         Height="22"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="Black"
                         CaretBrush="Black"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"
                         KeyDown="QueryTextBox_KeyDown"/>

                <TextBlock Name="DotButton" Text="." FontSize="16" FontWeight="Bold" Foreground="Black" Cursor="Hand" Width="16" TextAlignment="Center"
                           MouseDown="DotButton_MouseDown" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"/>

                <Border Name="TransparentButton" Width="24" Height="22" Margin="6,0,0,0" Background="#01000000" Cursor="Hand"
                        MouseDown="TransparentButton_MouseDown"/>
            </StackPanel>

            <!-- 极简设置区：只保留透明度滑块。 -->
            <Grid x:Name="SettingsScrollViewer" Grid.Row="0" Grid.RowSpan="2" Margin="0" Background="#01000000" Visibility="Collapsed"
                  MouseDown="SettingsSurface_MouseDown">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <Slider Name="InputOpacitySlider"
                            Width="150"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            Margin="0,0,0,4"
                            ValueChanged="OpacitySlider_ValueChanged"
                            PreviewMouseLeftButtonUp="OpacitySlider_PreviewMouseLeftButtonUp"/>
                    <Slider Name="DotOpacitySlider"
                            Width="150"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            ValueChanged="OpacitySlider_ValueChanged"
                            PreviewMouseLeftButtonUp="OpacitySlider_PreviewMouseLeftButtonUp"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 兼容旧逻辑的隐藏控件：不参与极简可视 UI。 -->
        <Grid x:Name="HiddenCompatControls" Visibility="Collapsed">
            <TextBlock Name="SendButton" Text="S"/>
            <TextBlock Name="LocalSearchButton" Text="s"/>
            <TextBlock Name="CefCaptureButton" Text="C"/>
            <TextBlock Name="AutoToggleButton" Text="K"/>
            <TextBlock Name="SettingsButton" Text="."/>
            <TextBlock Name="ExitButton" Text="x"/>
            <ScrollViewer x:Name="OutputScrollViewer"><TextBox Name="OutputTextBox" Text=""/></ScrollViewer>
        </Grid>
    </Grid>
</Window>
